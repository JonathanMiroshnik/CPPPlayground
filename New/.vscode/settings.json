{
    // Keep VS Code's view of the project in sync with the Makefile build.
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.save": "cpp"
    },
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "makefile.configureOnOpen": true,
    // This project builds with the Makefile, not CMake, and the cmake binary
    // is not installed. Stop CMake Tools from prompting/erroring on open.
    "cmake.configureOnOpen": false,
    "files.exclude": {
        "**/build": true
    }
}
